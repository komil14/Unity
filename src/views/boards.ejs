<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/svg+xml" href="/unity-logo.svg" />
    <title>Unity | Articles</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.2/axios.min.js"></script>
</head>
<body>
    <nav class="sidebar">
        <div class="brand"><i class="fa-solid fa-leaf"></i> UNITY</div>
        <div class="menu">
            <div class="menu-label">Main</div>
            <a href="/admin" class="menu-item"><i class="fa-solid fa-grid-2"></i> Dashboard</a>
            <div class="menu-label">Management</div>
            <a href="/admin/users" class="menu-item"><i class="fa-solid fa-users"></i> Users</a>
            <a href="/admin/events" class="menu-item"><i class="fa-solid fa-calendar-days"></i> Events</a>
            <a href="/admin/boards" class="menu-item active"><i class="fa-solid fa-newspaper"></i> Articles</a>
            <a href="/admin/comments" class="menu-item"><i class="fa-solid fa-comments"></i> Comments</a>
        </div>
        <div style="padding: 20px;"><a href="/admin/logout" class="menu-item" style="color: var(--danger);"><i class="fa-solid fa-power-off"></i> Logout</a></div>
    </nav>

    <main class="main-content">
        <div class="top-bar">
            <div class="page-title">
                <h1>Community Board</h1>
                <p>Review articles posted by volunteers.</p>
            </div>
            <div class="admin-profile">
                <div class="admin-info"><span class="admin-name"><%= user.memberNick %></span><span class="admin-role">Super Admin</span></div>
                <div class="admin-avatar"><img src="https://ui-avatars.com/api/?name=<%= user.memberNick %>&background=10b981&color=fff&bold=true"></div>
            </div>
        </div>

        <div class="table-section">
            <div class="table-header">
                <h3>Latest Articles</h3>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Article</th>
                        <th>Author</th>
                        <th>Stats</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% boards.map(function(board) { %>
                    <tr>
                        <td>
                            <div class="user-cell">
                                <img src="<%= board.boardImage ? '/uploads/community/' + board.boardImage : 'https://placehold.co/100/162226/FFF?text=Article' %>" class="table-img" style="width: 55px; height: 35px;">
                                <span class="info-main"><%= board.boardTitle %></span>
                            </div>
                        </td>
                        <td>
                            <div class="user-cell">
                                <img src="<%= board.memberData.memberImage ? '/uploads/members/' + board.memberData.memberImage : 'https://ui-avatars.com/api/?name=' + board.memberData.memberNick %>" style="width: 24px; height: 24px; border-radius: 50%;">
                                <span><%= board.memberData.memberNick %></span>
                            </div>
                        </td>
                        <td style="color: var(--text-muted);">
                            <i class="fa-solid fa-eye"></i> <%= board.boardViews %> &nbsp; 
                            <i class="fa-solid fa-heart" style="color: #ef4444;"></i> <%= board.boardLikes %>
                        </td>
                        <td>
                            <div class="status-badge <%= board.boardStatus %>"><%= board.boardStatus %></div>
                        </td>
                        <td>
                            <select class="action-select" id="status-<%= board._id %>" onchange="updateStatus('board/edit', '<%= board._id %>')">
                                <option value="ACTIVE" <%= board.boardStatus === 'ACTIVE' ? 'selected' : '' %>>Visible</option>
                                <option value="DELETE" <%= board.boardStatus === 'DELETE' ? 'selected' : '' %>>Hidden</option>
                            </select>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>
    <script src="/js/main.js"></script>
</body>
</html>