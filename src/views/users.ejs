<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unity Admin | Users</title>
    <link rel="stylesheet" href="/css/main.css">
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.2/axios.min.js"></script>
</head>
<body>

    <!-- Sidebar (Same as Home) -->
    <div class="sidebar">
        <div class="brand">UNITY ADMIN</div>
        <div class="menu">
            <a href="/admin"><i class="fas fa-fw fa-tachometer-alt"></i> Dashboard</a>
            <a href="/admin/users" class="active"><i class="fas fa-fw fa-users"></i> Users</a>
            <a href="/admin/events"><i class="fas fa-fw fa-calendar"></i> Events</a>
            <a href="/admin/boards"><i class="fas fa-fw fa-newspaper"></i> Articles</a>
            <a href="/admin/comments"><i class="fas fa-fw fa-comments"></i> Comments</a>
        </div>
        <div class="menu" style="flex: 0; padding-bottom: 20px;">
            <a href="/admin/logout"><i class="fas fa-fw fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <div class="main">
        <div class="header">
            <div class="title"><h2>User Management</h2></div>
            <div class="user-info">Hi, <%= user.memberNick %></div>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Image</th>
                        <th>Nickname</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.map(function(member, index) { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td>
                                <img src="<%= member.memberImage ? '/uploads/members/' + member.memberImage : '/img/default-user.svg' %>" class="table-img" onerror="this.src='/img/default-user.svg'">
                            </td>
                            <td><%= member.memberNick %></td>
                            <td><%= member.memberPhone %></td>
                            <td>
                                <!-- Distinct color for ORG vs USER -->
                                <span class="badge <%= member.memberType %>">
                                    <%= member.memberType %>
                                </span>
                            </td>
                            <td>
                                <span class="badge <%= member.memberStatus %>"><%= member.memberStatus %></span>
                            </td>
                            <td>
                                <select id="status-<%= member._id %>" onchange="updateStatus('user/edit', '<%= member._id %>', 'status-<%= member._id %>')">
                                    <option value="ACTIVE" <%= member.memberStatus === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                                    <option value="PENDING" <%= member.memberStatus === 'PENDING' ? 'selected' : '' %>>PENDING</option>
                                    <option value="BLOCK" <%= member.memberStatus === 'BLOCK' ? 'selected' : '' %>>BLOCK</option>
                                    <option value="DELETE" <%= member.memberStatus === 'DELETE' ? 'selected' : '' %>>DELETE</option>
                                </select>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
