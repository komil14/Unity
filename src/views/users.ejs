<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Unity | Users</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.2/axios.min.js"></script>
</head>
<body>
    <nav class="sidebar">
        <div class="brand"><i class="fa-solid fa-leaf"></i> UNITY</div>
        <div class="menu">
            <div class="menu-label">Main</div>
            <a href="/admin" class="menu-item"><i class="fa-solid fa-grid-2"></i> Dashboard</a>
            <div class="menu-label">Management</div>
            <a href="/admin/users" class="menu-item active"><i class="fa-solid fa-users"></i> Users</a>
            <a href="/admin/events" class="menu-item"><i class="fa-solid fa-calendar-days"></i> Events</a>
            <a href="/admin/boards" class="menu-item"><i class="fa-solid fa-newspaper"></i> Articles</a>
            <a href="/admin/comments" class="menu-item"><i class="fa-solid fa-comments"></i> Comments</a>
        </div>
        <div style="padding: 20px;"><a href="/admin/logout" class="menu-item" style="color: var(--danger);"><i class="fa-solid fa-power-off"></i> Logout</a></div>
    </nav>

    <main class="main-content">
        <div class="top-bar">
            <div class="page-title">
                <h1>User Management</h1>
                <p>Verify organizations and manage volunteers.</p>
            </div>
            <div class="admin-profile">
                <div class="admin-info"><span class="admin-name"><%= user.memberNick %></span><span class="admin-role">Super Admin</span></div>
                <div class="admin-avatar"><img src="https://ui-avatars.com/api/?name=<%= user.memberNick %>&background=10b981&color=fff&bold=true"></div>
            </div>
        </div>

        <div class="table-section">
            <div class="table-header">
                <h3>Registered Members</h3>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Identity</th>
                        <th>Type</th>
                        <th>Contact</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.map(function(member) { %>
                    <tr>
                        <td>
                            <div class="user-cell">
                                <img src="<%= member.memberImage ? '/uploads/members/' + member.memberImage : 'https://ui-avatars.com/api/?name=' + member.memberNick + '&background=random' %>" class="table-img">
                                <div>
                                    <span class="info-main"><%= member.memberNick %></span>
                                    <span class="info-sub">ID: ...<%= member._id.toString().slice(-6) %></span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <!-- Visual distinction for Orgs -->
                            <span class="role-badge <%= member.memberType %>">
                                <%= member.memberType === 'ORG' ? 'ORGANIZATION' : 'VOLUNTEER' %>
                            </span>
                        </td>
                        <td><%= member.memberPhone %></td>
                        <td>
                            <div class="status-badge <%= member.memberStatus %>">
                                <% if(member.memberStatus === 'ACTIVE') { %><i class="fa-solid fa-check"></i><% } %>
                                <% if(member.memberStatus === 'PENDING') { %><i class="fa-solid fa-clock"></i><% } %>
                                <% if(member.memberStatus === 'BLOCK') { %><i class="fa-solid fa-ban"></i><% } %>
                                <%= member.memberStatus %>
                            </div>
                        </td>
                        <td>
                            <select class="action-select" id="status-<%= member._id %>" onchange="updateStatus('user/edit', '<%= member._id %>')">
                                <option value="ACTIVE" <%= member.memberStatus === 'ACTIVE' ? 'selected' : '' %>>Allow Access</option>
                                <option value="PENDING" <%= member.memberStatus === 'PENDING' ? 'selected' : '' %>>Pending Review</option>
                                <option value="BLOCK" <%= member.memberStatus === 'BLOCK' ? 'selected' : '' %>>Block User</option>
                                <option value="DELETE" <%= member.memberStatus === 'DELETE' ? 'selected' : '' %>>Delete Account</option>
                            </select>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>
    <script src="/js/main.js"></script>
</body>
</html>