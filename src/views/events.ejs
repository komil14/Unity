<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/svg+xml" href="/unity-logo.svg" />
    <title>Unity | Events</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.2/axios.min.js"></script>
</head>
<body>
    <nav class="sidebar">
        <div class="brand"><i class="fa-solid fa-leaf"></i> UNITY</div>
        <div class="menu">
            <div class="menu-label">Main</div>
            <a href="/admin" class="menu-item"><i class="fa-solid fa-grid-2"></i> Dashboard</a>
            <div class="menu-label">Management</div>
            <a href="/admin/users" class="menu-item"><i class="fa-solid fa-users"></i> Users</a>
            <a href="/admin/events" class="menu-item active"><i class="fa-solid fa-calendar-days"></i> Events</a>
            <a href="/admin/boards" class="menu-item"><i class="fa-solid fa-newspaper"></i> Articles</a>
            <a href="/admin/comments" class="menu-item"><i class="fa-solid fa-comments"></i> Comments</a>
        </div>
        <div style="padding: 20px;"><a href="/admin/logout" class="menu-item" style="color: var(--danger);"><i class="fa-solid fa-power-off"></i> Logout</a></div>
    </nav>

    <main class="main-content">
        <div class="top-bar">
            <div class="page-title">
                <h1>Event Oversight</h1>
                <p>Manage community events created by organizations.</p>
            </div>
            <div class="admin-profile">
                <div class="admin-info"><span class="admin-name"><%= user.memberNick %></span><span class="admin-role">Super Admin</span></div>
                <div class="admin-avatar"><img src="https://ui-avatars.com/api/?name=<%= user.memberNick %>&background=10b981&color=fff&bold=true"></div>
            </div>
        </div>

        <div class="table-section">
            <div class="table-header">
                <h3>All Events</h3>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Event Details</th>
                        <th>Location</th>
                        <th>Organizer</th>
                        <th>Capacity</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% events.map(function(event) { %>
                    <tr>
                        <td>
                            <div class="user-cell">
                                <img src="<%=
                                    event.eventImages[0]
                                        ? '/uploads/events/' + (event.eventImages[0].includes('/') ? event.eventImages[0].split('/').pop() : event.eventImages[0])
                                        : 'https://placehold.co/100/162226/FFF?text=Event'
                                %>" class="table-img" style="width: 55px; height: 35px;">
                                <div>
                                    <span class="info-main"><%= event.eventTitle %></span>
                                    <span class="info-sub"><%= new Date(event.eventDate).toLocaleDateString() %></span>
                                </div>
                            </div>
                        </td>
                        <td style="color: var(--text-muted);"><i class="fa-solid fa-map-pin"></i> <%= event.eventLocation %></td>
                        <td><span class="role-badge ORG"><%= event.memberData.memberNick %></span></td>
                        <td><%= event.eventJoined %> / <%= event.eventCapacity %></td>
                        <td>
                            <div class="status-badge <%= event.eventStatus %>">
                                <%= event.eventStatus %>
                            </div>
                        </td>
                        <td>
                            <select class="action-select" id="status-<%= event._id %>" onchange="updateStatus('event/edit', '<%= event._id %>')">
                                <option value="ACTIVE" <%= event.eventStatus === 'ACTIVE' ? 'selected' : '' %>>Publish</option>
                                <option value="DELETE" <%= event.eventStatus === 'DELETE' ? 'selected' : '' %>>Delete</option>
                            </select>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>
    <script src="/js/main.js"></script>
</body>
</html>