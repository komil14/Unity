<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/img/unity-logo.svg" type="image/svg+xml">
    <title>Unity | Dashboard</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
  </head>
  <body>
    <!-- Sidebar -->
    <nav class="sidebar">
      <div class="brand"><i class="fa-solid fa-leaf"></i> UNITY</div>
      <div class="menu">
        <div class="menu-label">Main</div>
        <a href="/admin" class="menu-item active">
          <i class="fa-solid fa-grid-2"></i> Dashboard
        </a>

        <div class="menu-label">Management</div>
        <a href="/admin/users" class="menu-item">
          <i class="fa-solid fa-users"></i> Users
        </a>
        <a href="/admin/events" class="menu-item">
          <i class="fa-solid fa-calendar-days"></i> Events
        </a>
        <a href="/admin/boards" class="menu-item">
          <i class="fa-solid fa-newspaper"></i> Articles
        </a>
        <a href="/admin/comments" class="menu-item">
          <i class="fa-solid fa-comments"></i> Comments
        </a>
      </div>
      <div style="padding: 20px">
        <a href="/admin/logout" class="menu-item" style="color: var(--danger)">
          <i class="fa-solid fa-power-off"></i> Logout
        </a>
      </div>
    </nav>

    <!-- Main -->
    <main class="main-content">
      <div class="top-bar">
        <div class="page-title">
          <h1>Dashboard</h1>
          <p>Welcome back, here is what's happening today.</p>
        </div>

        <div style="display: flex; align-items: center; gap: 20px">
          <!-- NOTIFICATION CENTER -->
          <div class="notification-box" onclick="clearBadge()">
            <i class="fa-solid fa-bell notification-icon"></i>

            <!-- Safe EJS Logic for Badge -->
            <% if (typeof notifications !== 'undefined' && notifications.total >
            0) { %>
            <div id="notif-badge" class="notification-badge">
              <%= notifications.total %>
            </div>
            <% } else { %>
            <div
              id="notif-badge"
              class="notification-badge"
              style="display: none"
            >
              0
            </div>
            <% } %>

            <!-- Dropdown -->
            <div class="notification-dropdown">
              <div class="notif-header">Recent Updates</div>

              <% if (typeof notifications === 'undefined' || notifications.total
              === 0) { %>
              <div class="notif-empty">No new updates today.</div>
              <% } else { %> <% if (notifications.pendingOrgs > 0) { %>
              <a href="/admin/users" class="notif-item">
                <div class="notif-icon warn">
                  <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="notif-text">
                  <strong
                    ><%= notifications.pendingOrgs %> Pending Org(s)</strong
                  >
                  require approval.
                </div>
              </a>
              <% } %> <% if (notifications.newUsers > 0) { %>
              <a href="/admin/users" class="notif-item info">
                <div class="notif-icon info">
                  <i class="fa-solid fa-user-plus"></i>
                </div>
                <div class="notif-text">
                  <strong><%= notifications.newUsers %> New User(s)</strong>
                  joined in last 24h.
                </div>
              </a>
              <% } %> <% if (notifications.newEvents > 0) { %>
              <a href="/admin/events" class="notif-item success">
                <div class="notif-icon success">
                  <i class="fa-solid fa-calendar-plus"></i>
                </div>
                <div class="notif-text">
                  <strong><%= notifications.newEvents %> New Event(s)</strong>
                  created recently.
                </div>
              </a>
              <% } %> <% if (notifications.newBoards > 0) { %>
              <a href="/admin/boards" class="notif-item success">
                <div class="notif-icon success">
                  <i class="fa-solid fa-pen-nib"></i>
                </div>
                <div class="notif-text">
                  <strong><%= notifications.newBoards %> New Article(s)</strong>
                  posted.
                </div>
              </a>
              <% } %> <% } %>
            </div>
          </div>

          <div class="admin-profile">
            <div class="admin-info">
              <span class="admin-name"><%= user.memberNick %></span>
              <span class="admin-role">Super Admin</span>
            </div>
            <div class="admin-avatar">
              <img
                src="https://ui-avatars.com/api/?name=<%= user.memberNick %>&background=10b981&color=fff&bold=true"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Logic for Notification Card -->
      <% const pendingCount = (typeof stats !== 'undefined' && stats.members) ?
      stats.members.pending : 0; const isPending = pendingCount > 0; %>

      <div class="stats-container">
        <!-- PENDING CARD -->
        <a href="/admin/users" style="text-decoration: none">
          <div class="stat-card <%= isPending ? 'action-required' : '' %>">
            <div class="stat-icon"><i class="fa-solid fa-bell"></i></div>
            <div class="stat-value"><%= pendingCount %></div>
            <div class="stat-label">Pending Org Approvals</div>
            <% if(isPending) { %>
            <div
              style="
                margin-top: 10px;
                font-size: 0.8rem;
                color: var(--secondary);
                font-weight: 600;
              "
            >
              <i class="fa-solid fa-circle-exclamation"></i> Action Required
            </div>
            <% } %>
          </div>
        </a>

        <div class="stat-card">
          <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
          <div class="stat-value"><%= stats.members.total %></div>
          <div class="stat-label">Total Members</div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
          <div class="stat-value"><%= stats.events %></div>
          <div class="stat-label">Active Events</div>
        </div>

        <div class="stat-card">
          <div class="stat-icon"><i class="fa-solid fa-newspaper"></i></div>
          <div class="stat-value"><%= stats.boards %></div>
          <div class="stat-label">Articles Posted</div>
        </div>

        <div class="stat-card">
          <div class="stat-icon"><i class="fa-solid fa-user-slash"></i></div>
          <div class="stat-value"><%= stats.members.blocked || 0 %></div>
          <div class="stat-label">Blocked Users</div>
        </div>
      </div>

      <div class="table-section">
        <div class="table-header">
          <h3>
            <i
              class="fa-solid fa-rocket"
              style="color: var(--primary); margin-right: 10px"
            ></i>
            Quick Actions
          </h3>
        </div>
        <div
          style="padding: 40px; text-align: center; color: var(--text-muted)"
        >
          <% if(isPending) { %>
          <h2 style="color: var(--secondary); margin-bottom: 10px">
            You have <%= pendingCount %> new requests!
          </h2>
          <p>
            Organizations are waiting for your verification to start posting
            events.
          </p>
          <a
            href="/admin/users"
            style="
              display: inline-block;
              margin-top: 20px;
              color: #0b1215;
              background-color: var(--primary);
              padding: 12px 24px;
              border-radius: 8px;
              text-decoration: none;
              font-weight: 700;
              transition: all 0.2s;
            "
          >
            Go to Users Page &rarr;
          </a>
          <% } else { %>
          <i
            class="fa-solid fa-check-circle"
            style="
              font-size: 3rem;
              color: var(--primary);
              margin-bottom: 15px;
              opacity: 0.5;
            "
          ></i>
          <p>All systems operational. No pending actions.</p>
          <% } %>
        </div>
      </div>
    </main>

    <!-- FIXED SCRIPT -->
    <script>
      // Use quotes to make it a string, then parse. If empty, default to '0'.
      const rawTotal =
        "<%= (typeof notifications !== 'undefined' && notifications.total) ? notifications.total : 0 %>";
      const serverTotal = Number(rawTotal);

      const badge = document.getElementById("notif-badge");
      const lastSeenCount = localStorage.getItem("notif_count");

      if (
        serverTotal > 0 &&
        (!lastSeenCount || serverTotal > parseInt(lastSeenCount))
      ) {
        if (badge) badge.style.display = "flex";
      } else {
        if (badge) badge.style.display = "none";
      }

      function clearBadge() {
        if (badge) badge.style.display = "none";
        localStorage.setItem("notif_count", serverTotal);
      }
    </script>
  </body>
</html>
