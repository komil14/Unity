<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unity Admin | Login</title>
    <link rel="stylesheet" href="/css/main.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="auth-body">
    <div class="auth-card">
        <h2 style="color: #4e73df; margin-bottom: 20px; font-weight: 800;">UNITY ADMIN</h2>
        <p style="margin-bottom: 30px; font-size: 0.9rem;">Welcome back! Please login.</p>
        
        <form action="/admin/login" method="POST">
            <input type="text" name="memberNick" class="auth-input" placeholder="Enter Username..." required>
            <input type="password" name="memberPassword" class="auth-input" placeholder="Password" required>
            <button type="submit" class="btn-primary">Login</button>
        </form>
        
        <div style="margin-top: 20px; font-size: 0.8rem;">
            <a href="/admin/signup" style="color: #4e73df; text-decoration: none;">Create an Account!</a>
        </div>
    </div>
</body>
</html>