<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Unity | Admin Login</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
  </head>
  <body>
    <div class="auth-wrapper">
      <div class="auth-card">
        <div class="auth-logo">
          <i class="fa-solid fa-leaf"></i>
        </div>
        <div class="auth-h">Unity Admin</div>
        <p class="auth-p">Secure access for platform management</p>

        <form action="/admin/login" method="POST">
          <div class="input-group">
            <label>Username</label>
            <input
              type="text"
              name="memberNick"
              class="modern-input"
              placeholder="e.g. admin_main"
              required
            />
          </div>
          <div class="input-group">
            <label>Password</label>
            <input
              type="password"
              name="memberPassword"
              class="modern-input"
              placeholder="••••••••"
              required
            />
          </div>
          <button type="submit" class="btn-glow">Access Dashboard</button>
        </form>

        <div class="auth-footer">
          Need to create a root admin? <a href="/admin/signup">Sign Up</a>
        </div>
      </div>
    </div>
  </body>
</html>
