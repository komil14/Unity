<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/svg+xml" href="/unity-logo.svg" />
    <title>Unity | Comments</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.2/axios.min.js"></script>
</head>
<body>
    <nav class="sidebar">
        <div class="brand"><i class="fa-solid fa-leaf"></i> UNITY</div>
        <div class="menu">
            <div class="menu-label">Main</div>
            <a href="/admin" class="menu-item"><i class="fa-solid fa-grid-2"></i> Dashboard</a>
            <div class="menu-label">Management</div>
            <a href="/admin/users" class="menu-item"><i class="fa-solid fa-users"></i> Users</a>
            <a href="/admin/events" class="menu-item"><i class="fa-solid fa-calendar-days"></i> Events</a>
            <a href="/admin/boards" class="menu-item"><i class="fa-solid fa-newspaper"></i> Articles</a>
            <a href="/admin/comments" class="menu-item active"><i class="fa-solid fa-comments"></i> Comments</a>
        </div>
        <div style="padding: 20px;"><a href="/admin/logout" class="menu-item" style="color: var(--danger);"><i class="fa-solid fa-power-off"></i> Logout</a></div>
    </nav>

    <main class="main-content">
        <div class="top-bar">
            <div class="page-title">
                <h1>Comment Moderation</h1>
                <p>Manage user discussions.</p>
            </div>
            <div class="admin-profile">
                <div class="admin-info"><span class="admin-name"><%= user.memberNick %></span><span class="admin-role">Super Admin</span></div>
                <div class="admin-avatar"><img src="https://ui-avatars.com/api/?name=<%= user.memberNick %>&background=10b981&color=fff&bold=true"></div>
            </div>
        </div>

        <div class="table-section">
            <div class="table-header">
                <h3>Recent Comments</h3>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Comment</th>
                        <th>Author</th>
                        <th>Likes</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% comments.map(function(comment) { %>
                    <tr>
                        <td style="max-width: 400px; color: var(--text-muted);">
                            <i class="fa-solid fa-quote-left" style="color: var(--primary); margin-right: 5px; opacity: 0.5;"></i>
                            <%= comment.commentContent %>
                        </td>
                        <td>
                            <div class="user-cell">
                                <img src="<%= comment.memberData.memberImage ? '/uploads/members/' + comment.memberData.memberImage : 'https://ui-avatars.com/api/?name=' + comment.memberData.memberNick %>" style="width: 24px; height: 24px; border-radius: 50%;">
                                <span><%= comment.memberData.memberNick %></span>
                            </div>
                        </td>
                        <td style="color: #ef4444;"><i class="fa-solid fa-heart"></i> <%= comment.commentLikes %></td>
                        <td>
                            <select class="action-select" id="status-<%= comment._id %>" onchange="updateStatus('comment/edit', '<%= comment._id %>')">
                                <option value="ACTIVE" <%= comment.commentStatus === 'ACTIVE' ? 'selected' : '' %>>Visible</option>
                                <option value="DELETE" <%= comment.commentStatus === 'DELETE' ? 'selected' : '' %>>Hidden</option>
                            </select>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>
    <script src="/js/main.js"></script>
</body>
</html>