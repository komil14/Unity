# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/unity

# JWT secret for token signing (use a long random string)
TOKEN_SECRET=your-jwt-secret-here-change-this

# Express session secret (use a long random string)
SESSION_SECRET=your-session-secret-here-change-this

# Server port
PORT=3008

# Node environment (development | production)
NODE_ENV=development

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
